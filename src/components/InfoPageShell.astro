---
import {
  brandSubtitle,
  copyrightYear,
  infoPages,
  logoPath,
  siteName,
  siteOwner,
  sitePublisher,
} from "../config/site.js";

interface Props {
  title: string;
  titleZh: string;
  eyebrow?: string;
  current?: "about" | "guide" | "sources" | "privacy";
}

const {
  title,
  titleZh,
  eyebrow = "家长指南 · Family Guide",
  current,
} = Astro.props;

const currentPage = infoPages.find((page) => page.id === current);
---

<main class="info-page" id="main-content">
  <header class="info-topbar">
    <a class="info-brand" href="/" aria-label={`返回 ${siteName} 首页`}>
      <img src={logoPath} width="512" height="512" alt={siteName} />
      <span>
        <strong>{siteName}</strong>
        <small>{brandSubtitle}</small>
      </span>
    </a>
    <a class="info-back" href="/">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="m15 18-6-6 6-6"></path></svg
      >
      <span>返回词典</span>
    </a>
  </header>

  <article class="info-card">
    {
      currentPage && (
        <nav class="info-breadcrumb" aria-label="页面位置">
          <a href="/">{siteName}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{currentPage.label}</span>
        </nav>
      )
    }

    <div class="info-hero">
      <div class="info-eyebrow">{eyebrow}</div>
      <h1>{titleZh}</h1>
      <p class="info-title-en" lang="en">{title}</p>
    </div>

    <div class="info-content">
      <slot />
    </div>
  </article>

  <nav class="info-links" aria-label="家长指南页面">
    {
      infoPages.map((page) => (
        <a
          href={page.path}
          aria-current={current === page.id ? "page" : undefined}
        >
          <span>{page.label}</span>
          <small>{page.labelEn}</small>
        </a>
      ))
    }
  </nav>

  <a class="info-mobile-home" href="/">
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 9.5V21h14V9.5"
      ></path><path d="M9 21v-7h6v7"></path></svg
    >
    返回词典首页
  </a>

  <footer class="info-footer">
    © {copyrightYear}
    {siteOwner} · Powered by {sitePublisher}
  </footer>
</main>
