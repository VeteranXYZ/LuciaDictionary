---
import MainLayout from "../layouts/MainLayout.astro";
import InfoPageShell from "../components/InfoPageShell.astro";
import { buildInfoPageStructuredData } from "../lib/seo.js";
import { infoPageById, siteName } from "../config/site.js";

const title = `${siteName} 数据来源`;
const description = `了解 ${siteName} 使用的本地词典、课堂短句、音标、联网查词、翻译和图片文字识别服务。`;
const canonicalPath = infoPageById.sources.path;
const structuredData = buildInfoPageStructuredData({
  path: canonicalPath,
  title,
  description,
});
---

<MainLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogTitle={title}
  appScript={false}
  structuredData={structuredData}
>
  <InfoPageShell
    title="Dictionary Sources and Attribution"
    titleZh="词典数据来源"
    current="sources"
  >
    <p>
      {siteName}
      会先使用随应用提供的词典和课堂短句；本地内容不足时，才会按需使用联网查词、翻译或图片文字识别服务。不同来源的结果可能存在差异。
    </p>
    <section>
      <h2>本地词典与课堂短句</h2>
      <p>
        应用包含一份适合浏览器使用的核心词典、基础备用词表、常见课堂短句和音标提示。常用内容可以直接在设备上查询，但并不代表所有英文词都一定有完整的本地释义。
      </p>
    </section>
    <section>
      <h2>词典数据来源与许可</h2>
      <p>
        核心词典由公开的高频词汇表与开源词典数据整理、筛选和改写生成。本站会按以下许可条款使用并再分发这些数据：
      </p>
      <ul class="source-list">
        <li>
          <strong>ECDICT</strong> · 英汉字典数据库，采用 MIT 许可证。项目地址：<a
            href="https://github.com/skywind3000/ECDICT"
            rel="noopener noreferrer"
            target="_blank">github.com/skywind3000/ECDICT</a
          >。本站使用其中的中文释义与音标字段，并针对小学课堂场景做了筛选和改写。
        </li>
        <li>
          <strong>高频词汇表</strong> ·
          用于确定词条收录范围与学习分级的公开词频数据，仅用于排序，不随应用分发原始词频文件。
        </li>
        <li>
          <strong>dictionaryapi.dev</strong> ·
          联网补充释义的来源，其英文释义主要来自 Wiktionary，遵循 <a
            href="https://creativecommons.org/licenses/by-sa/3.0/"
            rel="noopener noreferrer"
            target="_blank">CC BY-SA 3.0</a
          >。这类释义只在本地查不到时按需获取，并缓存在你的浏览器中。
        </li>
      </ul>
      <p>
        页面上的“基础词、进阶词、拓展词”是本站为安排学习顺序自定的分级，不代表学校年级标准或考试等级认证。
      </p>
    </section>
    <section>
      <h2>课堂短句</h2>
      <p>
        课堂短句覆盖常见的作业要求、阅读指令、数学和科学提示以及课堂习惯表达。输入相近的中文或英文短句时，应用会优先在这些内容中查找。
      </p>
    </section>
    <section>
      <h2>联网补充</h2>
      <p>
        本地内容不足时，应用可能通过 dictionaryapi.dev
        补充英文释义。中文翻译由本站自己的接口完成：句子先发送到同源的 <code
          >/api/translate</code
        >，再由服务端调用 Cloudflare Workers AI
        的翻译模型，浏览器不会直接连接任何第三方翻译服务。联网结果可能随服务状态而变化，并会缓存在当前浏览器中。
      </p>
      <p>
        在设置页开启“仅离线模式”后，上述联网补充和图片识别都会停止，应用只使用自带的词典与课堂短句。
      </p>
    </section>
    <section>
      <h2>图片文字识别</h2>
      <p>
        拍照识别英文时，图片会先在浏览器中压缩，再通过本站接口发送给 OCR.Space
        完成文字识别。关于图片和识别结果如何处理，请查看“隐私与数据”页面。
      </p>
    </section>
  </InfoPageShell>
</MainLayout>
