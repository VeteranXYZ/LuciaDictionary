{
  "name": "lucia-dictionary",
  "version": "3.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tools/generate-phrasebook.mjs && node tools/build-phrase-lexicon.mjs && node tools/build-site-metadata.mjs && astro dev",
    "dev:cloudflare": "npm run build && wrangler dev",
    "build": "node tools/generate-phrasebook.mjs && node tools/build-phrase-lexicon.mjs && node tools/build-site-metadata.mjs && astro build && node tools/build-service-worker.mjs && node tools/build-security-headers.mjs",
    "build:runtime-lexicon": "node tools/build-runtime-lexicon.mjs",
    "build:phrasebook": "node tools/generate-phrasebook.mjs",
    "build:phrase-lexicon": "node tools/build-phrase-lexicon.mjs",
    "build:security-headers": "node tools/build-security-headers.mjs",
    "build:site-metadata": "node tools/build-site-metadata.mjs",
    "build:lexicon": "node tools/build-core-lexicon.mjs",
    "build:hfv-ecdict-core": "node tools/build-hfv-ecdict-core.mjs",
    "audit:lexicon": "node tools/audit-lexicon.mjs",
    "audit:seo": "node tools/validate-seo.mjs",
    "audit:hfv-ecdict-core": "node tools/audit-hfv-ecdict-core.mjs",
    "audit:ocr-sample": "node tools/audit-ocr-sample-coverage.mjs",
    "audit:translation-quality": "node tools/audit-translation-quality.mjs",
    "audit:offline": "node tools/audit-offline-build.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "audit:all": "npm run audit:lexicon && npm run audit:seo && npm run audit:ocr-sample && npm run audit:translation-quality && npm run audit:offline",
    "preview": "astro preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run cf:types && astro check",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.js",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "cf:build": "wrangler deploy --dry-run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm run test:all && npm run build && npm run audit:all && npm run cf:build"
  },
  "dependencies": {
    "terser": "^5.51.2"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "astro": "^7.2.9",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  }
}
